   "source": [
    "import os\n",
    "import fastf1\n",
    "\n",
    "cache_dir = \"../cache\"\n",
    "os.makedirs(cache_dir, exist_ok=True)\n",
    "\n",
    "fastf1.Cache.enable_cache(cache_dir)\n",
    "\n",
    "session = fastf1.get_session(2023, \"Monaco\", \"R\")\n",
    "session.load()\n",
    "\n",
    "laps = session.laps\n",
    "print(laps.head())\n",
    "print(laps.columns)"
   ]
  }
